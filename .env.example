# ── Frontend (Vite) ────────────────────────────────────────────────────────
# These are safe for the browser (anon/public keys only).
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# ── Edge Function secrets (Supabase, NOT Vite) ──────────────────────────────
# These are server-side only. Set them on the project, e.g.:
#   supabase secrets set GEMINI_API_KEY=... ANTHROPIC_API_KEY=... \
#     OPENCODE_API_KEY=... STRIPE_SECRET_KEY=... STRIPE_WEBHOOK_SECRET=... \
#     STRIPE_PRO_PRICE_ID=... STRIPE_STUDIO_PRICE_ID=... \
#     SUPABASE_SERVICE_ROLE_KEY=... ANON_IP_SALT="$(openssl rand -hex 24)" \
#     MAX_GENERATION_COST_USD=2.0
#
# GEMINI_API_KEY        # Google Gemini (default provider)
# ANTHROPIC_API_KEY     # Anthropic (Studio plan only)
# OPENCODE_API_KEY      # Opencode Zen (Studio plan only)
# STRIPE_SECRET_KEY     # Stripe secret key
# STRIPE_WEBHOOK_SECRET # Stripe webhook signing secret
# STRIPE_PRO_PRICE_ID   # Stripe Price ID for Pro ($29/mo)
# STRIPE_STUDIO_PRICE_ID# Stripe Price ID for Studio ($99/mo)
# SUPABASE_SERVICE_ROLE_KEY # service-role key (server only — NEVER expose)
# ANON_IP_SALT          # HMAC salt to hash anonymous IPs (rotate a fresh value)
# MAX_GENERATION_COST_USD # optional per-request AI cost ceiling (default 2.0)
